// Important : uses auth.prisma for User model !



// Chat Thread between 2 or more users.
//  - one conversation -> many messages
//  - one conversation -> many participants (users)
//  - Important : NO direct relation between users and conversations. Use a join table : ConversationParticipant
model Conversation {
    id        String   @id @default(cuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    participants ConversationParticipant[]
    messages     Message[]
}


// Join table for many-to-many relationship between User and Conversation
//  - one conversation -> many participants (users)
//  - other metadata : lastReadAt, joinedAt, etc. (specific to each users)
model ConversationParticipant {
    conversationId String
    userId         String

    conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
    user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

    lastReadAt DateTime?   // markMsgAsRead
    joinedAt   DateTime @default(now())

    @@id([conversationId, userId])  // A user can only appear once per conversation.
    @@index([userId])
}


// Single message in a conversation
// - belongs to a conversation
// - belongs to a user (senderId)
model Message {
    id             String   @id @default(cuid())   // Unique msg id.
    conversationId String
    senderId       String
    text           String
    createdAt      DateTime @default(now())

    conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
    sender       User         @relation(fields: [senderId], references: [id])

    @@index([conversationId, createdAt]) // Allows Faster loading of conversation messages ordered by time.
    @@index([senderId])    // Allows Faster loading of messages by sender
}







